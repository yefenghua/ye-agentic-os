[Unit]
Description=ye-os privileged action broker
Documentation=file:///usr/local/src/ye-os/docs/tutorials/ch01-principal.md
After=dbus.service polkit.service systemd-journald@ai-audit.service
Wants=polkit.service

[Service]
Type=dbus
BusName=org.yeos.Broker1
ExecStart=/usr/local/bin/ye-broker
Restart=on-failure
RestartSec=2
LogNamespace=ai-audit
Environment=RUST_LOG=warn

# 以 root 运行，但不是全权 root。
# dpkg 要 CHOWN/FOWNER/FSETID/DAC_OVERRIDE/MKNOD，apt 沙箱要 SETUID/SETGID，
# 维护脚本可能 KILL 进程，btrfs 快照和 yetxn 挂载要 SYS_ADMIN。
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL CAP_MKNOD CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target